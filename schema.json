{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/minitongue/schema.json",
  "title": "Minitongue normalized linguistic data",
  "description": "Derived interchange model for canonical grammar, lexicon, and example data. x-tei annotations are non-normative TEI P5 mapping hints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "grammar",
    "lexicon",
    "examples"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "grammar": {
      "$ref": "#/$defs/grammar"
    },
    "lexicon": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lexeme"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/example"
      }
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "features": {
      "type": "object",
      "additionalProperties": true
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tag",
        "metalanguage",
        "project_version",
        "status"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "metalanguage": { "type": "string", "minLength": 1 },
        "project_version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "stable", "archived"] }
      }
    },
    "grammarRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "domain", "title", "statement"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^G-(PHON|ORTH|MORPH|SYN|SEM|PRAG|DISC|LEX)-[0-9]{3,}$" },
        "domain": { "type": "string", "enum": ["PHON", "ORTH", "MORPH", "SYN", "SEM", "PRAG", "DISC", "LEX"] },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "conditions": { "type": "string" },
        "exceptions": { "type": "string" },
        "features": { "$ref": "#/$defs/features" },
        "depends_on": { "$ref": "#/$defs/idList" },
        "example_refs": { "$ref": "#/$defs/idList" }
      }
    },
    "pos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "glossAbbreviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abbreviation", "meaning", "source"],
      "properties": {
        "abbreviation": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9.-]*$" },
        "meaning": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "enum": ["leipzig", "project"] },
        "notes": { "type": "string" }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "parts_of_speech", "gloss_abbreviations"],
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/$defs/grammarRule" } },
        "parts_of_speech": { "type": "array", "items": { "$ref": "#/$defs/pos" } },
        "gloss_abbreviations": { "type": "array", "items": { "$ref": "#/$defs/glossAbbreviation" } }
      }
    },
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sense_id", "definition"],
      "properties": {
        "sense_id": { "type": "string", "pattern": "^L-[0-9]{4,}-S[0-9]{2,}$" },
        "definition": { "type": "string", "minLength": 1 },
        "usage": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "lexeme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexeme_id", "lemma", "ipa", "pos", "features", "senses"],
      "properties": {
        "lexeme_id": { "type": "string", "pattern": "^L-[0-9]{4,}$" },
        "lemma": { "type": "string", "minLength": 1 },
        "ipa": { "type": "string", "minLength": 1, "pattern": "^[^/\\[\\]]+$" },
        "pos": { "type": "string", "minLength": 1 },
        "features": { "$ref": "#/$defs/features" },
        "etymology": { "type": "string" },
        "senses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sense" }
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["example_id", "judgment", "text", "ipa", "segmentation", "gloss", "translation", "rule_refs", "violated_rule_refs", "lexeme_refs"],
      "properties": {
        "example_id": { "type": "string", "pattern": "^EX-[0-9]{4,}$" },
        "judgment": { "type": "string", "enum": ["grammatical", "ungrammatical", "marginal"] },
        "text": { "type": "string", "minLength": 1 },
        "ipa": { "type": "string", "minLength": 1, "pattern": "^[^/\\[\\]]+$" },
        "segmentation": { "type": "string", "minLength": 1 },
        "gloss": { "type": "string", "minLength": 1 },
        "translation": { "type": "string", "minLength": 1 },
        "rule_refs": { "$ref": "#/$defs/idList" },
        "violated_rule_refs": { "$ref": "#/$defs/idList" },
        "lexeme_refs": { "$ref": "#/$defs/idList" },
        "notes": { "type": "string" }
      }
    }
  }
}
